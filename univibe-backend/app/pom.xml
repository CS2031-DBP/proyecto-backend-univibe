      <groupId>com.univibe</groupId>
      <artifactId>univibe-notification</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.univibe</groupId>
      <artifactId>univibe-survey</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.univibe</groupId>
      <artifactId>univibe-integration-googlecalendar</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
